# ═══════════════════ 必填 ═══════════════════

# Telegram API 凭据（my.telegram.org → API development tools）
API_ID=
API_HASH=

# 机器人令牌（@BotFather → /newbot）
BOT_TOKEN=

# 管理员 Telegram 用户 ID，多个用空格分隔
OWNER_ID=

# 会话和辅助机器人 Token 的加密密钥：必填，MASTER_KEY 至少 32 字符，
# 空值、短值和公开示例密钥会阻止启动。
# 部署脚本自动生成；已有实例请保持原值，不要在更新时重新生成。
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_KEY=
# python3 -c "import secrets; print(secrets.token_urlsafe(16))"
SALT_KEY=

# ═══════════════════ 可选 ═══════════════════

# Premium 账号 Session String，解锁 4GB 大文件上传（需同时设置 LOG_GROUP）
# STRING=

# 大文件中转频道 ID（-100 开头，机器人需有发送权限）
# LOG_GROUP=

# 批量提取相邻两条消息之间的间隔秒数，默认 3
# BATCH_DELAY=3

# 全局同时进行的下载/上传搬运上限，默认 3
# MAX_CONCURRENT_TRANSFERS=3

# 用户两次提取任务之间的最小间隔秒数（防刷），默认 3
# USER_COOLDOWN=3

# 连续无进度超时（秒）；持续下载/上传不会按总时长超时
TASK_STALL_TIMEOUT=300

# 裸机可指定外部持久目录，默认 /var/lib/tgforward；Compose 自动注入 /app/data
# DATA_DIR=/var/lib/tgforward
